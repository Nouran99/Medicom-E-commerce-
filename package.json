{
  "name": "medicum-egypt",
  "version": "1.1.0",
  "private": true,
  "description": "A bilingual Egyptian healthcare e-commerce portfolio project built with Hono, Supabase, and Railway.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test",
    "seed:products": "node load_data_to_supabase.js"
  },
  "keywords": [
    "portfolio",
    "healthcare",
    "e-commerce",
    "egypt",
    "supabase",
    "hono",
    "railway"
  ],
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@supabase/supabase-js": "^2.58.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "hono": "^4.9.8",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
